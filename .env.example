# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables. Never commit real keys.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Full database access; never expose to the browser.
SUPABASE_SECRET_KEY=

# AI providers (used from Milestone 1)
FAL_KEY=
ANTHROPIC_API_KEY=
# Optional. Vercel > AI Gateway > API Keys: Seedance videos (Better and Best)
# are filmed through AI Gateway at ByteDance's own price, about half of fal's,
# with fal as the backup.
AI_GATEWAY_API_KEY=
# Optional. Google AI Studio API key: Better and Best images use Nano Banana
# direct from Google at a lower price, with fal as the backup.
GEMINI_API_KEY=

# Comma-separated emails of team members who may put ad runs on the public
# /use-cases page ("Show on gooidy.com" button on a product's page).
SHOWCASE_ADMIN_EMAILS=

# Stripe (billing). `npm run stripe:setup -- https://your-domain` creates the
# plans, webhook and portal and prints the values below.
# Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# The webhook's signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price ids (price_...): each plan's monthly and yearly price.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_GROWTH_YEARLY=
# Only if the setup script printed one.
STRIPE_PORTAL_CONFIGURATION=
# "on" to add sales tax / VAT with Stripe Tax (turn Stripe Tax on first).
STRIPE_AUTOMATIC_TAX=
# Any long random string. Vercel's daily job sends it to /api/cron/plan-credits,
# which gives yearly plans their monthly credits.
CRON_SECRET=

# Publishing to social networks (zernio.com > Settings > API keys). Without
# it the Publishing page says publishing is being switched on.
ZERNIO_API_KEY=
# Any long random string; paste the same value as the webhook's secret in
# Zernio > Webhooks (URL: https://gooidy.com/api/webhooks/zernio).
ZERNIO_WEBHOOK_SECRET=

# Catalog foundation (disabled by default). Use separate test and production keys.
CATALOG_INGESTION_ENABLED=false
# 32 random bytes encoded as 64 hex characters; protects per-store webhook secrets.
CATALOG_ENCRYPTION_KEY=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_SERVE_ORIGIN=https://gooidy.com
# Paid pilot: one explicit workspace/product URL; never enables bulk training.
CATALOG_TRAINING_ENABLED=false
CATALOG_PILOT_WORKSPACE_ID=
CATALOG_PILOT_PRODUCT_URL=
REPLICATE_API_TOKEN=
# Pin a verified replicate/fast-flux-trainer version (64 hex characters).
REPLICATE_TRAINER_VERSION=
# A pre-created PRIVATE Replicate destination, owner/model.
REPLICATE_TRAINING_DESTINATION=

# Platform-owned Shopify app. Merchants authorize in the dashboard; never enter secrets there.
SHOPIFY_CONNECT_ENABLED=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_APP_ORIGIN=https://gooidy.com

# Native connected catalogs: platform app registrations and acceptance tests are required.
WOOCOMMERCE_CONNECT_ENABLED=false
WIX_CONNECT_ENABLED=false
WIX_CLIENT_ID=
WIX_CLIENT_SECRET=
WIX_INSTALL_URL=
WIX_SHARE_URL_ID=
SQUARESPACE_CONNECT_ENABLED=false
SQUARESPACE_CLIENT_ID=
SQUARESPACE_CLIENT_SECRET=
BIGCOMMERCE_CONNECT_ENABLED=false
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
