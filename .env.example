# Copy to .env.local for local development, and add the same values in
# Vercel > Project > Settings > Environment Variables. Never commit real keys.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Full database access; never expose to the browser.
SUPABASE_SECRET_KEY=

# AI providers (used from Milestone 1)
FAL_KEY=
ANTHROPIC_API_KEY=

# Comma-separated emails of team members who may put ad runs on the public
# /use-cases page ("Show on gooidy.com" button on a product's page).
SHOWCASE_ADMIN_EMAILS=

# Stripe (billing). `npm run stripe:setup -- https://your-domain` creates the
# plans, webhook and portal and prints the values below.
# Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# The webhook's signing secret (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Price ids of the monthly USD prices (price_...) for each plan.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_GROWTH=
# Only if the setup script printed one.
STRIPE_PORTAL_CONFIGURATION=
# "on" to add sales tax / VAT with Stripe Tax (turn Stripe Tax on first).
STRIPE_AUTOMATIC_TAX=
